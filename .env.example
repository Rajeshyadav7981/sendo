# Top-level convenience env. Each app reads its own apps/<app>/.env.
# This file documents the values you need to set across the whole platform.

# ── Backend (apps/backend/.env) ─────────────────────────────────────────────
NODE_ENV=production
PORT=5001
APP_BASE_URL=http://localhost
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=sendo
DB_PASSWORD=sendo_change_me
DB_DATABASE=sendo
DB_SCHEMA=sendo
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_COOKIE_SECRET=replace-me-with-yet-another-random-string

# COMMON_EMP_PASSWORD is what the supervisor app sends as x-emp-password.
COMMON_EMP_PASSWORD=tracker123

# Twilio / Email — leave blank for log-based OTPs in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

CORS_ORIGINS=http://localhost
MAX_FILE_SIZE_BYTES=10485760
UPLOADS_DIR=./uploads

# ── Admin (apps/admin/.env / .env.production) ───────────────────────────────
# In dev:        VITE_API_BASE=http://localhost:5001/api
# In prod build: VITE_API_BASE=/api  (set in apps/admin/.env.production)

# ── Driver (apps/driver/.env / .env.production) ─────────────────────────────
# Same convention as admin.

# ── Supervisor (apps/supervisor/.env / .env.production) ─────────────────────
# Supervisor's client appends `/api` itself. Use:
#   dev:  VITE_API_BASE=http://localhost:5001
#   prod: VITE_API_BASE= (empty — calls land at /api)

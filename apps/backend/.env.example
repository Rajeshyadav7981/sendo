# Application
NODE_ENV=development
PORT=5001
APP_NAME=sendo-backend
LOG_LEVEL=debug

# Postgres (TypeORM)
DB_HOST=localhost
DB_PORT=54322
DB_USERNAME=demo
DB_PASSWORD=demo
DB_DATABASE=demo
DB_SCHEMA=sendo
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# Redis (cache, OTP, sessions, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=replace-me-with-a-strong-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-me-too
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-me-cookie-secret

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Email (SMTP / SES)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Sendo <noreply@sendo.local>"

# Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_DEFAULT_COUNTRY_CODE=+91

# File uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Public base URL
BASE_URL=http://localhost:5001

# Throttler
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Seed defaults
SEED_ADMIN_EMAIL=admin@sendo.local
SEED_ADMIN_PASSWORD=ChangeMe!123
